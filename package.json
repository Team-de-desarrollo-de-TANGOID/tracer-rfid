{
  "name": "racket-club-trazabilidad",
  "version": "0.2.0",
  "description": "RFID TRACER — Trazabilidad y gestión de activos con RFID. Desarrollado e implementado por TANGOID SRL.",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "ports:free": "kill-port 3847 5173",
    "predev": "npm run ports:free",
    "predev:web": "npm run ports:free",
    "dev": "concurrently -k -n api,vite,electron -c blue,green,magenta \"npm run server\" \"npm run vite\" \"npm run electron:wait\"",
    "dev:web": "concurrently -k -n api,vite -c blue,green \"npm run server\" \"npm run vite\"",
    "vite": "vite",
    "server": "node --watch server/index.js",
    "server:once": "node server/index.js",
    "electron:wait": "wait-on http://localhost:5173 http://localhost:3847/api/health && electronmon .",
    "build": "vite build",
    "preview": "vite preview",
    "test:packaged": "npm run build && cross-env FC_PACKAGED_MODE=1 electron .",
    "pack:portable": "npm run build && electron-builder --win portable",
    "pack:folder": "npm run build && electron-builder --win dir",
    "pack:all": "npm run build && electron-builder --win portable dir"
  },
  "build": {
    "appId": "com.tangoid.racketclub.demo",
    "productName": "RFID TRACER",
    "copyright": "Copyright © TANGOID SRL",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**/*",
      "server/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "extraFiles": [
      {
        "from": "demo-portable/LEEME.txt",
        "to": "LEEME.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "RacketClub-Trazabilidad-demo-portable.exe"
    },
    "nsis": {
      "oneClick": false
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "kill-port": "^2.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.2"
  },
  "electronmon": {
    "patterns": [
      "electron/**"
    ]
  },
  "author": "TANGOID SRL"
}
